<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <link rel="icon" href="favicon.ico" sizes="any">
  <link rel="stylesheet" href="styles.css">
  <link rel="alternate" type="application/rss+xml" title="Kolja Sam" href="feed.xml">

  <script>
    window.goatcounter = {
      path: function (p) { return location.host + p }
    }
  </script>
  <script data-goatcounter="https://koljasam.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
</head>

<body>
  <main>
    <p class="back"><a href="index.html">&larr; all posts</a></p>
    <article>
      <h1>{{ title }}</h1>
      {% if created or updated %}
      <p class="dates">
        {% if created %}<time>created {{ created }}</time>{% endif %}
        {% if updated %}<time>updated {{ updated }}</time>{% endif %}
      </p>
      {% endif %}
      {{ content|safe }}
    </article>
  </main>
</body>

</html>