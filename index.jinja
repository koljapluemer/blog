<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Posts</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <main>
    <h1>Posts</h1>
    <ul class="post-list">
      {% for post in posts %}
      <li>
        <a href="{{ post.url }}">{{ post.title }}</a>
        {% if post.created or post.updated %}
        <span class="dates">
          {% if post.created %}<time>created {{ post.created }}</time>{% endif %}
          {% if post.updated %}<time>updated {{ post.updated }}</time>{% endif %}
        </span>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
  </main>
</body>
</html>
